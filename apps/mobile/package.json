{
  "name": "@otter-mail/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "APP_VARIANT=development expo start --dev-client --scheme ottermail-dev",
    "dev:reset": "APP_VARIANT=development expo start --dev-client --scheme ottermail-dev --clear",
    "ios": "APP_VARIANT=development EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:prod": "APP_VARIANT=production EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios --configuration Release --no-bundler",
    "eas:ios:dev": "eas build --profile development -p ios",
    "eas:ios:prod": "eas build --profile production -p ios",
    "config:dev": "APP_VARIANT=development expo config",
    "config:prod": "APP_VARIANT=production expo config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@otter-mail/contracts": "workspace:*",
    "@react-navigation/elements": "2.9.26",
    "@react-navigation/native": "7.3.4",
    "@react-navigation/native-stack": "7.17.6",
    "clsx": "^2.1.1",
    "expo": "~57.0.18",
    "expo-auth-session": "~57.0.10",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.11.4",
    "tailwind-merge": "^3.5.0",
    "uniwind": "1.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.9",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}

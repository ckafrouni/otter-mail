// mail.otterware.dev: Otter Mail's home page, privacy policy and terms.
// Static files only. Cloudflare Workers Builds deploys it on pushes to main
// that touch site/ (`pnpm --filter @otter-mail/site run deploy`).
{
  "name": "otter-mail-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "mail.otterware.dev", "custom_domain": true }],
}

// mail.otterware.app: the web app (apps/web), assembled in dist/ by
// scripts/build.ts. The Worker redirects the old domain and the pages that moved
// to otterware.app/mail/, and answers the app's own pages with the app.
// Cloudflare Workers Builds deploys it on pushes to main
// (`pnpm --filter @otter-mail/site run deploy`).
{
  "name": "otter-mail-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Every old-domain URL, including static assets and /app, must redirect.
    "run_worker_first": true,
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "mail.otterware.app", "custom_domain": true },
    { "pattern": "mail.otterware.dev", "custom_domain": true },
  ],
}

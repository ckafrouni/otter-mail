# Copy to .env.local (gitignored) for local builds; CI reads the same names
# from the repository's Actions variables and secrets.

# Google OAuth "Desktop app" client in the otter-mail Google Cloud project
# (console.cloud.google.com/auth/clients?project=otter-mail).
OTTER_MAIL_GOOGLE_CLIENT_ID=
OTTER_MAIL_GOOGLE_CLIENT_SECRET=

# Google OAuth "iOS" client for the mobile app (apps/mobile), in the same
# project, with bundle ID dev.otterware.mail (and dev.otterware.mail.dev for dev
# builds, which need their own client). iOS clients have no secret.
OTTER_MAIL_GOOGLE_IOS_CLIENT_ID=

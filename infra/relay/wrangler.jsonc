// relay.mail.otterware.dev: Otter account sign-in, linked accounts and
// realtime Gmail notifications. `pnpm deploy` from this folder applies D1
// migrations, then deploys. See README.md.
{
  "name": "otter-mail-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // better-auth uses AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "relay.mail.otterware.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otter-mail-relay",
      "database_id": "c622d59a-1c2e-4fb8-bc4a-e01fa71b3c13",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  // Secrets (\`wrangler secret put\`): BETTER_AUTH_SECRET.
  "vars": {
    "BETTER_AUTH_URL": "https://relay.mail.otterware.dev",
    // The desktop app's OAuth client ("Desktop app" client in the otter-mail project).
    "GOOGLE_CLIENT_ID": "187875144740-aspevse90oidb4ra3t2fcdfmbagm6jep.apps.googleusercontent.com",
    "PUSH_TOPIC": "projects/otter-mail/topics/gmail-push",
    "PUSH_AUDIENCE": "https://relay.mail.otterware.dev/push/gmail",
    "PUSH_SERVICE_ACCOUNT": "gmail-push-relay@otter-mail.iam.gserviceaccount.com",
  },
  "observability": { "enabled": true },
}
